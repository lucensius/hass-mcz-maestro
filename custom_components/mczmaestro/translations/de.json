{
  "config": {
    "step": {
      "user": {
        "title": "MCZ Maestro einrichten",
        "description": "Verbindung zum Ofen. Home Assistant muss den Ofen direkt erreichen (WLAN des Ofens).",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]",
          "scan_interval": "Sekunden zwischen den Abfragen"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]"
    }
  },
  "services": {
    "set_chrono_day": {
      "name": "Chrono-Tag setzen",
      "description": "Setzt das Wochenprogramm eines oder mehrerer Tage. Zeiten in halben Stunden; nicht angegebene Zeiten sind aus, ein leerer Plan schaltet den Tag aus.",
      "fields": {
        "day": {
          "name": "Tag",
          "description": "Zu programmierende Tage."
        },
        "schedule": {
          "name": "Plan",
          "description": "Liste mit start, end (HH:MM) und temperature (T1, T2 oder T3)."
        },
        "config_entry_id": {
          "name": "Ofen",
          "description": "Nur bei mehreren Öfen nötig."
        }
      }
    },
    "copy_chrono_day": {
      "name": "Chrono-Tag kopieren",
      "description": "Kopiert das Programm eines Tages auf andere Tage.",
      "fields": {
        "source": {
          "name": "Quelltag",
          "description": "Tag, von dem kopiert wird."
        },
        "target": {
          "name": "Zieltage",
          "description": "Tage, auf die kopiert wird."
        },
        "config_entry_id": {
          "name": "Ofen",
          "description": "Nur bei mehreren Öfen nötig."
        }
      }
    },
    "start_heating": {
      "name": "Heizen starten",
      "description": "Heizt ab jetzt über das Chrono. Ohne Angaben gelten die Entitäten Heizdauer und Heizstufe.",
      "fields": {
        "hours": {
          "name": "Stunden",
          "description": "Dauer in Stunden."
        },
        "temperature": {
          "name": "Temperatur",
          "description": "Chrono-Stufe T1, T2 oder T3."
        },
        "config_entry_id": {
          "name": "Ofen",
          "description": "Nur bei mehreren Öfen nötig."
        }
      }
    },
    "stop_heating": {
      "name": "Heizen stoppen",
      "description": "Beendet die mit Heizen starten oder dem Start-Knopf begonnene Heizphase.",
      "fields": {
        "config_entry_id": {
          "name": "Ofen",
          "description": "Nur bei mehreren Öfen nötig."
        }
      }
    }
  },
